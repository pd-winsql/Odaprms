ointment_id` = `a`.`appointment_id`)) left join `db-oaprms-system`.`users` `recorder` on(`recorder`.`id` = `b`.`recorded_by_user_id`)) left join `db-oaprms-system`.`staffs` `recorder_staff` on(`recorder_staff`.`user_id` = `recorder`.`id`))
